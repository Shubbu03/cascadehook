# Configure the actual connection URL as a Railway service variable.
DATABASE_URL=
# API only: set the Railway domain target port to match this listener.
HTTP_ADDR=0.0.0.0:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
# Optional API/worker metrics listener. Leave both empty to disable.
# On Railway use [::]:9090 on the private network and a randomly generated token
# (at least 32 non-space ASCII characters). Scrape GET /metrics with Bearer auth.
# Keep this port separate from HTTP_ADDR and out of public domain routing.
METRICS_ADDR=
METRICS_TOKEN=
# API and worker: use the same base64-encoded 32-byte key to decrypt stored signing secrets.
SIGNING_ENCRYPTION_KEY=
# API: configure all three below to enable Clerk session authentication.
# The janitor also uses CLERK_ISSUER_URL with its secret key for account deletion.
# Exact instance HTTPS origin, such as https://your-instance.clerk.accounts.dev (no trailing slash).
CLERK_ISSUER_URL=
# Clerk Dashboard -> API keys -> JWT public key; use the complete multiline PEM value.
CLERK_JWT_PUBLIC_KEY=
# Comma-separated HTTPS origins of your app, with no paths or trailing slashes.
CLERK_AUTHORIZED_PARTIES=
# Janitor only: same Clerk instance as CLERK_ISSUER_URL; required to finish account deletion.
# API/worker do not use this secret. Leave empty while building without provider cleanup.
CLERK_SECRET_KEY=
# API request budgets: global is per process; project is shared in PostgreSQL.
# Use the same project settings on every API replica. Values must be positive integers.
API_GLOBAL_RPS=200
API_GLOBAL_BURST=400
API_PROJECT_RPS=20
API_PROJECT_BURST=40
# Worker only: each process enforces its own concurrency limits.
WORKER_CONCURRENCY=32
WORKER_DESTINATION_CONCURRENCY=4
WORKER_CLAIM_BATCH_SIZE=10
WORKER_POLL_INTERVAL=1s
# Janitor only: history retention and requested project/organization/account cleanup.
RETENTION_DAYS=30
JANITOR_BATCH_SIZE=100
JANITOR_MAX_BATCHES=100
JANITOR_RUN_TIMEOUT=5m
