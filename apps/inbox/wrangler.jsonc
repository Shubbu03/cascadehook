{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cascadehook-inbox",
  "main": "src/index.ts",
  // 2026-02-24 or later: storage.deleteAll() also removes the pending alarm.
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "in.cascadehook.com", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "INBOX", "class_name": "Inbox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Inbox"] }],
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "SEND_IP_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "SEND_INBOX_LIMIT", "namespace_id": "1003", "simple": { "limit": 30, "period": 10 } }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://cascadehook.com",
    "TOOL_URL": "https://cascadehook.com/tools/webhook-tester"
  },
  // Workers Logs would record request URLs, and captured query strings can hold secrets.
  "observability": { "enabled": false }
}
