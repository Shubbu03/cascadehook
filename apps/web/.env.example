# Use the same Clerk application already configured on the Go API.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/login#/create"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Go API origin, without /v1. Public URL; never put credentials here.
NEXT_PUBLIC_API_BASE_URL=

# Optional docs origin. Leave empty in production when /docs uses the app domain.
# Local development defaults to http://localhost:3001 when omitted.
NEXT_PUBLIC_DOCS_URL=http://localhost:3001
