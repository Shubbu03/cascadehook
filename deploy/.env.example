# Generated by init-env.sh. Preserve these values when updating the deployment.
# Changing passwords here does not rotate passwords in an existing database.
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_PASSWORD=
SIGNING_ENCRYPTION_KEY=
SIGNING_ENCRYPTION_PREVIOUS_KEY=

# For a public launch, use the Production instance of the Clerk application.
# Production activation requires a domain you own with configurable DNS.
# Keep development keys in local development files, not this production .env.
# The Cloudflare frontend must use that same instance's pk_live_ and sk_live_.
# Leave all Clerk fields empty only for the initial health/readiness check.
CLERK_ISSUER_URL=
CLERK_SECRET_KEY=
# Enclose the complete multiline PEM in single quotes.
CLERK_JWT_PUBLIC_KEY=''
# Exact frontend origin, e.g. https://cascadehook-web.your-account.workers.dev.
# Separate multiple origins with commas. Wildcards are not accepted.
CLERK_AUTHORIZED_PARTIES=
CLERK_WEBHOOK_SIGNING_SECRETS=

# Optional invitation emails. Configure together once the frontend URL is known.
# Use a dedicated Resend sending key and a sender on a verified owned domain.
# resend.dev is restricted to testing emails to your Resend account's address.
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
INVITATION_ACCEPT_URL=
EMAIL_DAILY_LIMIT=100

# Initial settings for a VM with 1 GB RAM.
WORKER_CONCURRENCY=4
WORKER_DESTINATION_CONCURRENCY=2
WORKER_CLAIM_BATCH_SIZE=4
RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=90

# Named Cloudflare Tunnel. Used only by the production-profile cloudflare service.
# Copy the tunnel connector token from its Docker installation command.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional Dodo billing. Leave API key empty to keep paid checkout disabled.
# Create these four recurring products manually; see ../docs/billing-setup.md.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
BILLING_APP_URL=https://cascadehook.com
DODO_STARTER_MONTHLY_PRODUCT_ID=
DODO_STARTER_ANNUAL_PRODUCT_ID=
DODO_GROWTH_MONTHLY_PRODUCT_ID=
DODO_GROWTH_ANNUAL_PRODUCT_ID=
