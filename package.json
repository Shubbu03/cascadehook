{
  "name": "cascadehook",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "cd apps/server && go run ./cmd/api",
    "dev:worker": "cd apps/server && go run ./cmd/worker",
    "db:migrate": "cd apps/server && go run ./cmd/migrate",
    "db:seed": "cd apps/server && go run ./cmd/seed",
    "db:cleanup": "cd apps/server && go run ./cmd/janitor",
    "ops:project": "cd apps/server && go run ./cmd/projectctl",
    "ops:tenant": "cd apps/server && go run ./cmd/tenantctl",
    "ops:secrets": "cd apps/server && go run ./cmd/secretctl",
    "build:go": "cd apps/server && go build ./...",
    "fmt:go": "cd apps/server && go fmt ./...",
    "vet:go": "cd apps/server && go vet ./...",
    "test:go": "cd apps/server && go test -race ./..."
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
